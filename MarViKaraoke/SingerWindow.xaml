<Window x:Class="MarViKaraoke.SingerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MarViKaraoke.Models"
        Title="MarVi Karaoke - Layar TV (Dual Screen)" 
        Height="720" Width="1280"
        Background="#060812"
        Icon="/MarViKaraoke;component/Assets/logo.png"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="WordStyle">
            <Setter Property="FontSize" Value="52" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Foreground" Value="#55ffffff" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Foreground" Value="#ff007f" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#ff007f" BlurRadius="30" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#00f0ff" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="20" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Title, Artist & Singer Badge -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Background="#070b19" Padding="6,4" Margin="0,0,18,0" BorderBrush="#1a274c" BorderThickness="1">
                    <Image Source="/MarViKaraoke;component/Assets/logo.png" Height="62" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="15" ShadowDepth="0" />
                        </Image.Effect>
                    </Image>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSongTitle" Text="MarVi Karaoke Pro" FontSize="36" FontWeight="Black" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="25" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TxtArtist" Text="Pilih lagu untuk bernyanyi" FontSize="20" FontWeight="Bold" Foreground="#00f0ff" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#7928ca" CornerRadius="25" Padding="24,10">
                <TextBlock x:Name="TxtSinger" Text="🎤 Tamu" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
            </Border>
        </DockPanel>

        <!-- Center Stage: Word-by-Word Glowing Karaoke Lyrics -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtIntroStatus" Text="♪ Musik Intro ♪" FontSize="44" FontWeight="Bold" Foreground="#00f0ff" HorizontalAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed" />
            <ItemsControl x:Name="WordsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="1100" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LyricWord}">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource WordStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#1a000000" CornerRadius="18" Padding="24,8" Margin="0,30,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtNextLyric" Text="Siapkan vokal terbaikmu! 🎤" FontSize="22" FontWeight="SemiBold" Foreground="#88ffffff" />
            </Border>
        </StackPanel>

        <!-- Footer: Fullscreen Tip & Next Song Queue -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Left" x:Name="TxtNextSongBanner" Text="" FontSize="18" FontWeight="Bold" Foreground="#ffaa00" />
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="Tekan F11 untuk Layar Penuh (TV)" FontSize="15" Foreground="#666666" />
        </DockPanel>
    </Grid>
</Window>
