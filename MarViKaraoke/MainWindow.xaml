<Window x:Class="MarViKaraoke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MarViKaraoke.Models"
        xmlns:controls="clr-namespace:MarViKaraoke.Controls"
        Title="MarVi Karaoke Pro .NET" Height="820" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        Background="#060812"
        Icon="/MarViKaraoke;component/Assets/logo.png"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Word Karaoke Style -->
        <Style TargetType="TextBlock" x:Key="StageWordStyle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Foreground" Value="#55ffffff" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Foreground" Value="#ff007f" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#ff007f" BlurRadius="25" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="#00f0ff" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00f0ff" BlurRadius="15" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Button Styles -->
        <Style TargetType="Button" x:Key="NeonBtn">
            <Setter Property="Background" Value="#151b33" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#22ffffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryActionBtn" BasedOn="{StaticResource NeonBtn}">
            <Setter Property="Background" Value="#00f0ff" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="Button" x:Key="RoundStepBtn" BasedOn="{StaticResource NeonBtn}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border BorderBrush="#1a2544" BorderThickness="1" Background="#060812">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" /> <!-- Custom Titlebar -->
                <RowDefinition Height="60" /> <!-- Top Header Nav -->
                <RowDefinition Height="*" />  <!-- Main Body Content -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Frameless Titlebar -->
            <Grid Grid.Row="0" Background="#080c1a" MouseDown="Titlebar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="/MarViKaraoke;component/Assets/logo.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MarVi Karaoke Pro (.NET 8 WPF Audio Engine)" FontWeight="Bold" FontSize="12" Foreground="#8fa0bc" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="46" Height="36" Background="Transparent" Foreground="#8fa0bc" BorderThickness="0" Content="─" Click="BtnMinimize_Click" />
                    <Button Width="46" Height="36" Background="Transparent" Foreground="#8fa0bc" BorderThickness="0" Content="□" Click="BtnMaximize_Click" />
                    <Button Width="46" Height="36" Background="Transparent" Foreground="#8fa0bc" BorderThickness="0" Content="✕" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- 2. Header Nav -->
            <Grid Grid.Row="1" Background="#0a0f22" Margin="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,4,0,4">
                    <Border CornerRadius="8" Background="#070b19" Padding="4,2" Margin="0,0,12,0" BorderBrush="#1a274c" BorderThickness="1">
                        <Image Source="/MarViKaraoke;component/Assets/logo.png" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KARAOKE PRO" FontSize="18" FontWeight="Black" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00f0ff" BlurRadius="12" ShadowDepth="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="AI Vocal Remover &amp; Pitch Control" FontSize="10" FontWeight="SemiBold" Foreground="#00f0ff" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource NeonBtn}" Content="🔄 Update" Margin="0,0,10,0" Click="BtnCheckUpdate_Click" ToolTip="Periksa Pembaruan Versi Aplikasi" />
                    <Button Style="{StaticResource PrimaryActionBtn}" Content="📺 Layar TV (Dual Screen)" Margin="0,0,10,0" Click="BtnOpenSingerWindow_Click" />
                    <Button Style="{StaticResource NeonBtn}" Content="📁 Pindai Folder" Margin="0,0,10,0" Click="BtnScanFolder_Click" />
                    <Button Style="{StaticResource NeonBtn}" Content="➕ Tambah File" Click="BtnAddFiles_Click" />
                </StackPanel>
            </Grid>

            <!-- 3. Main Body Grid: Left Stage (65%) & Right Library (35%) -->
            <Grid Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="35*" />
                </Grid.ColumnDefinitions>

                <!-- Left Stage & Player Controls -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="280" /> <!-- Stage Screen -->
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /> <!-- Playback Seek & Transport -->
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /> <!-- Audio DSP (Pitch, Tempo, Vocal, Volume) -->
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" /> <!-- Mic & Vocal Remover Bar -->
                    </Grid.RowDefinitions>

                    <!-- Stage Screen Card -->
                    <Border Grid.Row="0" Background="#0a0e1e" CornerRadius="16" BorderBrush="#1a274c" BorderThickness="1">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Song Meta -->
                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding CurrentSong.Title, FallbackValue='Pilih Lagu untuk Bernyanyi'}" FontSize="18" FontWeight="ExtraBold" Foreground="White" />
                                    <TextBlock Text="{Binding CurrentSong.Artist, FallbackValue='MarVi Karaoke .NET Core'}" FontSize="13" FontWeight="Bold" Foreground="#00f0ff" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#7928ca" CornerRadius="16" Padding="14,6" Cursor="Hand" MouseDown="SingerBadge_MouseDown">
                                    <TextBlock Text="{Binding CurrentSinger, StringFormat='🎤 {0}'}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                </Border>
                            </DockPanel>

                            <!-- Center: Word-by-Word Karaoke Glowing Text -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Teks intro/status jika belum ada kata-kata aktif -->
                                <TextBlock Text="{Binding ActiveLineText}" FontSize="24" FontWeight="Bold" Foreground="#00f0ff" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentWords.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding CurrentWords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="800" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LyricWord}">
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource StageWordStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding NextLineText}" FontSize="13" FontWeight="SemiBold" Foreground="#88ffffff" Margin="0,14,0,0" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Bottom Stage Status & Quick Offset -->
                            <DockPanel Grid.Row="2">
                                <Border Background="#1a000000" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Offset Lirik:" Foreground="#8fa0bc" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Content="⏪ -0.5s" Style="{StaticResource NeonBtn}" Padding="6,2" FontSize="11" Click="BtnOffsetMinus_Click" Margin="0,0,4,0" />
                                        <Border Background="#0f152d" CornerRadius="6" Padding="8,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding LyricOffsetDisplay}" Foreground="#00f0ff" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                        <Button Content="⏩ +0.5s" Style="{StaticResource NeonBtn}" Padding="6,2" FontSize="11" Click="BtnOffsetPlus_Click" Margin="0,0,4,0" />
                                        <Button Content="Reset" Style="{StaticResource NeonBtn}" Padding="6,2" FontSize="11" Click="BtnOffsetReset_Click" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Playback Controls Card -->
                    <Border Grid.Row="2" Background="#0d1226" CornerRadius="14" BorderBrush="#1a2548" BorderThickness="1" Padding="16,12">
                        <StackPanel>
                            <!-- Seek Bar Slider -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentTimeDisplay}" Foreground="#8fa0bc" FontSize="12" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="{Binding TotalDuration}" Value="{Binding CurrentPosition}" ValueChanged="SeekSlider_ValueChanged" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalDurationDisplay}" Foreground="#8fa0bc" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Control Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource NeonBtn}" Content="↺" Width="38" Height="38" FontSize="16" Click="BtnReplay_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource NeonBtn}" Content="⏹" Width="38" Height="38" FontSize="14" Click="BtnStop_Click" Margin="0,0,14,0" />
                                <Button x:Name="BtnPlayPause" Style="{StaticResource PrimaryActionBtn}" Content="▶" Width="48" Height="48" FontSize="20" FontWeight="Black" Click="BtnPlayPause_Click" Margin="0,0,14,0" />
                                <Button Style="{StaticResource NeonBtn}" Content="⏭" Width="38" Height="38" FontSize="14" Click="BtnNext_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio DSP (Pitch, Tempo, Offset, Volume) -->
                    <Border Grid.Row="4" Background="#0d1226" CornerRadius="14" BorderBrush="#1a2548" BorderThickness="1" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. Key Pitch -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="NADA DASAR (PITCH)" FontSize="10" FontWeight="Black" Foreground="#8fa0bc" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RoundStepBtn}" Content="-♭" Click="BtnPitchDown_Click" />
                                    <Border Background="#060918" CornerRadius="6" Padding="12,4" Margin="6,0">
                                        <TextBlock Text="{Binding PitchDisplay}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <Button Style="{StaticResource RoundStepBtn}" Content="+♯" Click="BtnPitchUp_Click" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource NeonBtn}" Content="0" Padding="8,4" FontSize="11" Click="BtnPitchReset_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 2. Tempo -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="TEMPO: " FontSize="10" FontWeight="Black" Foreground="#8fa0bc" />
                                    <TextBlock Text="{Binding TempoDisplay}" FontSize="10" FontWeight="Black" Foreground="#00f0ff" />
                                </StackPanel>
                                <Slider Minimum="0.75" Maximum="1.25" Value="{Binding TempoRate}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 3. Offset Lirik -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="OFFSET LIRIK: " FontSize="10" FontWeight="Black" Foreground="#8fa0bc" />
                                    <TextBlock Text="{Binding LyricOffsetDisplay}" FontSize="10" FontWeight="Black" Foreground="#00f0ff" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RoundStepBtn}" Content="-" Click="BtnOffsetMinus_Click" />
                                    <Button Style="{StaticResource RoundStepBtn}" Content="+" Click="BtnOffsetPlus_Click" Margin="6,0" />
                                    <Button Style="{StaticResource NeonBtn}" Content="Reset" Padding="8,4" FontSize="11" Click="BtnOffsetReset_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 4. Volume Musik -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="VOLUME MUSIK" FontSize="10" FontWeight="Black" Foreground="#8fa0bc" Margin="0,0,0,6" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Microphone & Real-Time Vocal Remover Bar -->
                    <Border Grid.Row="6" Background="#0d1226" CornerRadius="14" BorderBrush="#1a2548" BorderThickness="1" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleVocal" Style="{StaticResource NeonBtn}" Content="{Binding VocalButtonText}" Click="BtnToggleVocal_Click" Margin="0,0,10,0" />
                                <TextBlock Text="Redam:" Foreground="#8fa0bc" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding VocalAttenuation}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding VocalAttenuationPercent}" Foreground="#00f0ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Width="36" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbVocalMode" Width="140" Margin="0,0,10,0" SelectionChanged="CmbVocalMode_SelectionChanged">
                                    <ComboBoxItem Content="Hapus Vokal DSP" IsSelected="True" />
                                    <ComboBoxItem Content="Kiri Saja (Musik)" />
                                    <ComboBoxItem Content="Kanan Saja (Vokal)" />
                                    <ComboBoxItem Content="Stereo Penuh" />
                                </ComboBox>
                                <Button Style="{StaticResource NeonBtn}" Content="👏" Click="BtnApplause_Click" Margin="0,0,4,0" />
                                <Button Style="{StaticResource NeonBtn}" Content="🎺" Click="BtnAirhorn_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Right Library, Queue & YouTube Downloader -->
                <Border Grid.Column="2" Background="#0d1226" CornerRadius="16" BorderBrush="#1a2548" BorderThickness="1">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="TabBtnCatalog" Style="{StaticResource PrimaryActionBtn}" Content="📚 Koleksi Lagu" Margin="0,0,6,0" Click="TabBtnCatalog_Click" />
                            <Button x:Name="TabBtnQueue" Style="{StaticResource NeonBtn}" Content="⏳ Antrean" Margin="0,0,6,0" Click="TabBtnQueue_Click" />
                            <Button x:Name="TabBtnYouTube" Style="{StaticResource NeonBtn}" Content="🔴 YouTube Download" Click="TabBtnYouTube_Click" />
                        </StackPanel>

                        <!-- 1. Catalog Panel -->
                        <Grid x:Name="PanelCatalog" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" x:Name="TxtSearch" Background="#070a16" Foreground="White" BorderBrush="#1a2548" Padding="10,6" Margin="0,0,0,10" TextChanged="TxtSearch_TextChanged" />

                            <ListBox Grid.Row="1" x:Name="SongsListBox" Background="Transparent" BorderThickness="0" 
                                     ItemsSource="{Binding Catalog}" MouseDoubleClick="SongsListBox_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SongItem}">
                                        <Border Background="#101730" CornerRadius="8" Padding="10,8" BorderBrush="#1a2548" BorderThickness="1">
                                            <DockPanel LastChildFill="True">
                                                <!-- Aksi Lagu: Tombol Minimalis Lirik & AI + Putar & Antre -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Style="{StaticResource NeonBtn}" Content="🎵" Padding="7,4" FontSize="11" Margin="0,0,4,0" ToolTip="Unduh / Sinkron Lirik LRCLIB" Click="BtnSongFetchLyrics_Click" />
                                                    <Button Style="{StaticResource NeonBtn}" Content="✨" Padding="7,4" FontSize="11" Margin="0,0,6,0" ToolTip="Pemisahan Vokal AI Manual" Click="BtnSongAiSeparate_Click" />
                                                    <Button Style="{StaticResource PrimaryActionBtn}" Content="▶ Putar" Padding="12,5" FontSize="11" Click="BtnSongPlay_Click" Margin="0,0,6,0" ToolTip="Putar Sekarang" />
                                                    <Button Style="{StaticResource NeonBtn}" Content="+ Antre" Padding="12,5" FontSize="11" Click="BtnSongQueue_Click" ToolTip="Masukkan ke Antrean" />
                                                </StackPanel>

                                                <!-- Judul Lagu (Full / Running Text jika panjang) & Info Artis + Status AI Clean -->
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <controls:MarqueeTextBlock Grid.Row="0" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="White" Height="22" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#8fa0bc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding Artist}" />
                                                        <Border Visibility="{Binding HasAiInstrumental, Converter={StaticResource BoolToVis}}" Background="#12382c" BorderBrush="#00f0ff" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="✨ AI Clean" Foreground="#00f0ff" FontSize="9" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 2. Queue Panel -->
                        <Grid x:Name="PanelQueue" Grid.Row="1" Visibility="Collapsed">
                            <!-- Empty queue placeholder -->
                            <TextBlock x:Name="TxtEmptyQueueHint"
                                       Text="Belum ada lagu dalam antrean.&#x0a;Klik '+ Antre' pada daftar lagu untuk menambahkan antrean!"
                                       FontSize="13" Foreground="#6f7f9e" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="20" TextWrapping="Wrap" />

                            <ListBox x:Name="QueueListBox" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Queue}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="QueueListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="QueueListBox_PreviewMouseMove"
                                     PreviewMouseLeftButtonUp="QueueListBox_PreviewMouseLeftButtonUp"
                                     DragOver="QueueListBox_DragOver"
                                     Drop="QueueListBox_Drop">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:QueueItem}">
                                        <Border Background="#101730" CornerRadius="8" Padding="10,8" BorderBrush="#1a2548" BorderThickness="1">
                                            <DockPanel LastChildFill="True">
                                                <!-- Action Buttons: Play Now and Remove -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Style="{StaticResource PrimaryActionBtn}" Content="▶ Putar" Padding="10,4" FontSize="11" Click="BtnQueuePlayNow_Click" Margin="0,0,6,0" ToolTip="Putar lagu ini sekarang" />
                                                    <Button Style="{StaticResource NeonBtn}" Content="🗑️" Padding="8,4" FontSize="11" Click="BtnRemoveQueueItem_Click" ToolTip="Hapus dari antrean" Foreground="#ff4b72" BorderBrush="#ff007f" />
                                                </StackPanel>

                                                <!-- Drag Handle & Queue Info -->
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Drag handle icon -->
                                                    <Border Grid.Column="0" Width="26" Height="26" Background="#161e38" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Tahan dan seret untuk memindahkan posisi antrean" Cursor="SizeAll">
                                                        <TextBlock Text="⠿" FontSize="16" Foreground="#00f0ff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Title & Singer details -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <controls:MarqueeTextBlock Grid.Row="0" Text="{Binding Song.Title}" FontSize="13" FontWeight="Bold" Foreground="White" Height="22" VerticalAlignment="Center" />

                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding SingerName, StringFormat='🎤 Penyanyi: {0}'}" FontSize="11" Foreground="#00f0ff" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                            <TextBlock Text="{Binding Song.Artist, StringFormat=' • {0}'}" FontSize="11" Foreground="#8fa0bc" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 3. YouTube Search & Download Panel -->
                        <Grid x:Name="PanelYouTube" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- YouTube Search Input -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtYouTubeSearch" Text="{Binding YouTubeQuery, UpdateSourceTrigger=PropertyChanged}" Background="#070a16" Foreground="White" BorderBrush="#1a2548" Padding="10,6" Margin="0,0,6,0" KeyDown="TxtYouTubeSearch_KeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryActionBtn}" Content="🔍 Cari" Padding="12,6" Click="BtnYouTubeSearch_Click" />
                            </Grid>

                            <!-- YouTube Results List -->
                            <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding YouTubeResults}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:YouTubeSearchResult}">
                                        <Border Background="#101730" CornerRadius="8" Padding="10" BorderBrush="#1a2548" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource NeonBtn}" Content="{Binding StatusText}" Padding="8,4" FontSize="11" Click="BtnYouTubeDownload_Click" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding CanDownload}" Margin="8,0,0,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <controls:MarqueeTextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="White" Height="20" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#8fa0bc" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                            <TextBlock Text="{Binding DurationDisplay, StringFormat=' • {0}'}" FontSize="11" Foreground="#00f0ff" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Download Progress Bar -->
                                                <ProgressBar Grid.Row="1" Height="4" Margin="0,6,0,0" Value="{Binding DownloadProgress}" Maximum="100" Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}" Foreground="#00f0ff" Background="#070a16" BorderThickness="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Modern Dark Neon Floating Toast Notification -->
            <Border x:Name="NotificationToast"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Background="#141a33"
                    BorderBrush="#00f0ff"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,10"
                    Panel.ZIndex="900"
                    Opacity="0"
                    IsHitTestVisible="False"
                    MaxWidth="440">
                <Border.Effect>
                    <DropShadowEffect Color="#00f0ff" BlurRadius="25" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#0b1022" BorderBrush="#00f0ff" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtToastIcon" Text="✅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtToastTitle" Text="Ditambahkan ke Antrean" FontWeight="Bold" FontSize="13" Foreground="#00f0ff" />
                        <TextBlock x:Name="TxtToastMessage" Text="Judul Lagu..." FontSize="12" Foreground="White" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Modal AI Separation Progress Overlay -->
            <Grid x:Name="OverlayAiProcessing" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#c8030612">
                <Border Background="#0d1226" BorderBrush="#00f0ff" BorderThickness="1.5" CornerRadius="16" Width="460" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00f0ff" BlurRadius="30" ShadowDepth="0" Opacity="0.4" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🤖 Pemisahan Vokal AI (OwnVocalRemover)" FontSize="16" FontWeight="Black" Foreground="#00f0ff" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock x:Name="TxtAiSongTitle" Text="Nama Lagu..." FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        <ProgressBar x:Name="PbAiProgress" Height="8" Width="400" Minimum="0" Maximum="100" Value="0" Foreground="#00f0ff" Background="#060918" BorderThickness="0" Margin="0,0,0,10" />
                        <TextBlock x:Name="TxtAiStatus" Text="Menyiapkan model AI..." FontSize="12" Foreground="#8fa0bc" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modal In-App Auto Update Dialog Overlay -->
            <Grid x:Name="OverlayUpdate" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#d0030612">
                <Border Background="#0d1226" BorderBrush="#00f0ff" BorderThickness="1.5" CornerRadius="16" Width="540" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00f0ff" BlurRadius="35" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Modal Title Bar -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource NeonBtn}" Content="✕" Width="32" Height="32" Padding="0" Click="BtnCloseUpdateModal_Click" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pembaruan Aplikasi (In-App Updater)" FontSize="16" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <!-- GitHub Repo Input -->
                        <Border Background="#080c1a" BorderBrush="#1a2548" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GitHub Repo:" FontSize="11" Foreground="#8fa0bc" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtGitHubRepo" Background="Transparent" Foreground="#00f0ff" BorderThickness="0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Format: username/repository di GitHub" />
                                <Button Grid.Column="2" Style="{StaticResource NeonBtn}" Content="🔍 Cek" Padding="10,3" FontSize="11" Click="BtnRecheckUpdate_Click" Margin="6,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- Version Comparison Box -->
                        <Border Background="#141a33" BorderBrush="#1a274c" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Versi Terpasang" FontSize="11" Foreground="#8fa0bc" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtCurrentVersion" Text="v2.0.0" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="➔" FontSize="18" FontWeight="Bold" Foreground="#00f0ff" VerticalAlignment="Center" Margin="12,0" />
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Versi Terbaru" FontSize="11" Foreground="#8fa0bc" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtLatestVersion" Text="v2.0.0" FontSize="15" FontWeight="Bold" Foreground="#00f0ff" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Changelog / Status Area -->
                        <TextBlock Text="Catatan Rilis / Status:" FontSize="11" FontWeight="SemiBold" Foreground="#8fa0bc" Margin="0,0,0,6" />
                        <Border Background="#070a16" BorderBrush="#1a2548" BorderThickness="1" CornerRadius="8" Height="130" Margin="0,0,0,14" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtUpdateChangelog" Text="Memeriksa rilis terbaru dari GitHub..." Foreground="#d8e2f0" FontSize="12" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <!-- Download Progress Bar -->
                        <StackPanel x:Name="PanelUpdateProgress" Visibility="Collapsed" Margin="0,0,0,14">
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtUpdateProgressPct" DockPanel.Dock="Right" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#00f0ff" />
                                <TextBlock x:Name="TxtUpdateStatus" Text="Mengunduh berkas rilis..." FontSize="11" Foreground="#8fa0bc" />
                            </DockPanel>
                            <ProgressBar x:Name="PbUpdateDownload" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#00f0ff" Background="#060918" BorderThickness="0" />
                        </StackPanel>

                        <!-- Modal Buttons -->
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="TxtUpdateSizeInfo" DockPanel.Dock="Left" Text="" FontSize="11" Foreground="#00f0ff" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelUpdate" Style="{StaticResource NeonBtn}" Content="Tutup" Width="90" Margin="0,0,10,0" Click="BtnCloseUpdateModal_Click" />
                                <Button x:Name="BtnApplyUpdate" Style="{StaticResource PrimaryActionBtn}" Content="🚀 Unduh &amp; Perbarui" Padding="16,7" Click="BtnApplyUpdate_Click" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
